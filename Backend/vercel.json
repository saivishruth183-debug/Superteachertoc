{
    "version": 2,
    "builds": [
        { "src": "index.js", "use": "@vercel/node" },
        { "src": "uploads/**", "use": "@vercel/static" }
    ],
    "routes": [
        {
            "src": "/uploads/(.*)",
            "dest": "/uploads/$1",
            "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
        },
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ]
}
